<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# tree: DTX's own code under dtx/, and under nt4/ a carried copy
       of ST4's C# packer, so a DTX2 file is written with no packer beside
       this one. doc/tools.md defines the tools; LICENSE names the copy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- ST4's own C# tree builds with these on, and the copy under nt4/ is
         not edited here, so this builds it the way its own tree does. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dtx</AssemblyName>
    <RootNamespace></RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The twenty-two 68000 images, as go:embed takes them in the Go tree.
         A tree whose build has not run does not contain one, and Images.Read
         then gives nothing back. -->
    <EmbeddedResource Include="../build/68k/*.bin" Condition="Exists('../build/68k')" />
  </ItemGroup>

</Project>
