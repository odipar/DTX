#!/bin/sh
# The Java suite as .github/workflows/test.yml runs it, on this machine.
# A test that skips is a check that did not run, so this requires what the
# skipping tests need, runs the suite, and reads the skip count back: a
# count above 0 ends this with exit 1 and the lines that report it.
# doc/tools.md.
#
#   bin/suite [maven argument ...]
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# ParityTest reads the three trees against one another, and skips where
# go, dotnet or rmac is absent; RMAC names rmac where it is outside
# the path. BlobTest and PackagerTest assemble the readers, which is rmac
# again.
for one in go dotnet; do
    if ! command -v "$one" >/dev/null 2>&1; then
        echo "suite: ParityTest reads three trees, and $one is not on the path" >&2
        exit 2
    fi
done
if ! command -v "${RMAC:-rmac}" >/dev/null 2>&1; then
    echo "suite: the readers are assembled by ${RMAC:-rmac}, which is not on the"\
         "path; RMAC names another" >&2
    exit 2
fi

# RigCallsTest drives the 68000 reader under emulation, which needs
# python3 with unicorn in it.
if ! python3 -c "import unicorn" >/dev/null 2>&1; then
    echo "suite: RigCallsTest drives the reader under unicorn: pip install unicorn" >&2
    exit 2
fi

# St4Test reads the packer this tree has against the real one, which
# is at ST4. The release go.mod requires is the one the workflow
# builds, so a packer of another release is another set of bytes.
st4=$(sed -n 's|.*st4/go v\([0-9.]*\).*|\1|p' go/go.mod)
if [ ! -x "${ST4:-st4}" ]; then
    echo "suite: St4Test reads the packer here against the real one, and no"\
         "executable stands at ${ST4:-st4}; ST4 names it, and go.mod requires"\
         "ST4 $st4, whose packer builds from go/v$st4 of that repository" >&2
    exit 2
fi

log=target/suite.log
status=target/suite.status
mkdir -p target
( set +e; mvn -B --no-transfer-progress "$@" test 2>&1; echo $? > "$status" ) | tee "$log"
[ "$(cat "$status")" = 0 ] || exit "$(cat "$status")"

said=$(grep -oE 'Tests run: [0-9]+, Failures: [0-9]+, Errors: [0-9]+, Skipped: [0-9]+$' \
    "$log" | tail -1)
if [ -z "$said" ]; then
    echo "suite: the run reported no count of tests" >&2
    exit 1
fi
skipped=${said##*: }
if [ "$skipped" != 0 ]; then
    echo "suite: $skipped skipped, and a whole run reads 0" >&2
    grep -E 'Skipped: [1-9]' "$log" >&2
    exit 1
fi
echo "suite: $(echo "$said" | sed -n 's/^Tests run: \([0-9]*\).*/\1/p') tests, 0 skipped"
