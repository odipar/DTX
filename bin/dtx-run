#!/bin/sh
# Runs one of DTX's tools out of target/classes, and builds first where a
# source is newer than the last build. doc/tools.md defines the tools; the
# three scripts beside this one name a class and pass their arguments on.
#
# Paths reach the tool as the caller gave them, so a relative one is
# relative to the caller's directory and not to this repository's.
set -e

class=$1
shift

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classes=$root/target/classes
built=$classes/.built

# The code the packager combines from is built into target/classes, by the
# step bound to process-classes, so a build runs to there and a template
# under 68k/ dates it as a source does.
if [ ! -f "$built" ] || [ -n "$(find "$root/src/main/java" "$root/68k" \
        -newer "$built" -print -quit 2>/dev/null)" ]; then
    (cd "$root" && mvn -q process-classes)
    : > "$built"
fi

exec java -cp "$classes" "$class" "$@"
