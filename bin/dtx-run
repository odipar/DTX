#!/bin/sh
# Runs one of DTX's tools out of target/classes, and builds first where a
# source is newer than the last build. doc/tools.md defines the tools; the
# three scripts beside this one name a class and pass their arguments on.
#
# Paths reach the tool as the caller wrote them, so a relative one is
# relative to the caller's directory and not to this repository's.
set -e

class=$1
shift

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classes=$root/target/classes
built=$classes/.built
lock=$root/target/.building

# Whether a build is owed: no build yet, or a source newer than the last
# build. The code the packager combines from is built into target/classes,
# by the step bound to process-classes, so a template under 68k/ dates it as
# a source does.
owed() {
    [ ! -f "$built" ] || [ -n "$(find "$root/src/main/java" "$root/68k" \
        -newer "$built" -print -quit 2>/dev/null)" ]
}

build() {
    # A tool reads standard input and writes standard output, so the build
    # is handed no input and its output goes to standard error.
    (cd "$root" && mvn -q process-classes </dev/null >&2)
    : > "$built"
}

if owed; then
    # A pipe starts every tool at once, so two of them can owe the same
    # build. mkdir either makes the directory or does not, so the first
    # one through builds and the rest wait on it.
    mkdir -p "$root/target"
    waited=0
    while ! mkdir "$lock" 2>/dev/null; do
        waited=$((waited + 1))
        if [ "$waited" -gt 180 ]; then
            echo "dtx-run: a build has held $lock for three minutes" >&2
            exit 2
        fi
        sleep 1
    done
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT INT TERM
    # The one that waited may find the build already done.
    if owed; then
        build
    fi
    rmdir "$lock" 2>/dev/null || true
    trap - EXIT INT TERM
fi

exec java -cp "$classes" "$class" "$@"
